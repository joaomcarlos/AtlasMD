# Docker files
compose.yaml
docker-compose.yml
Dockerfile
.dockerignore

# Node.js dependencies and build artifacts
node_modules/
node_modules/*
npm-debug.log
yarn-debug.log
yarn-error.log
.pnpm-debug.log

# Nuxt.js build output
.nuxt/
.output/
.nitro/
.cache/
dist/

# Development files
.git/
.github/
.vscode/
.idea/
*.log
*.swp
*.bak

# Non necessary files
.*
makefile
justfile
README.md
AGENTS.md

# Scaffold artifacts — consumer content, mounted at runtime.
# config.toml is a symlink to atlasmd-scaffold/ (broken outside the dev host).
# content/ and public/ hold the scaffold's own docs; consumers mount their own.
# Dockerfile creates empty content/ and public/ via `mkdir -p`.
config.toml
content/
public/

# Generated by config.ts at build/import time — don't ship stale local copies
config.value.json

# Necessary files
!assets/
!components/
!plugins/
!.npmrc
!.nvmrc
!app.config.ts
!nuxt.config.ts
!tokens.config.ts
!tsconfig.json
